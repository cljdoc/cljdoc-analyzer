{:paths ["src" "resources" "modules"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/tools.deps {:mvn/version "0.31.1646"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        ch.qos.logback/logback-classic {:mvn/version "1.6.6"}
        version-clj/version-clj {:mvn/version "2.0.3"}
        org.babashka/cli {:mvn/version "0.12.92"}
        babashka/fs {:mvn/version "0.5.34"}
        babashka/process {:mvn/version "0.6.25"}
        org.ow2.asm/asm {:mvn/version "9.11.1"}
        ;; cljoc and cljdoc-analyzer should reference same version of cljdoc-shared
        cljdoc/cljdoc-shared {:git/url "https://github.com/cljdoc/cljdoc-shared.git"
                              :git/sha "3d3ed7b596703bbb937dbefdc96e14756606877e"}}
 :tools/usage {:ns-default cljdoc-analyzer.deps-tool}
 :aliases {:test
           {:extra-paths ["test/integration" "test-resources"]
            :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                         lambdaisland/kaocha-junit-xml {:mvn/version "1.17.101"}
                         nubank/matcher-combinators {:mvn/version "3.11.0"}}
            :main-opts ["-m" "kaocha.runner"]}

           :clj-kondo
           {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.10.26"}}
            :main-opts ["-m" "clj-kondo.main"]}

           :eastwood
           {:extra-paths ["test/integration"]
            :extra-deps {jonase/eastwood {:mvn/version "1.4.3"}}
            :main-opts ["-m" "eastwood.lint" {:source-paths ["src"]
                                              :test-paths ["test/integration"]}]}}}
